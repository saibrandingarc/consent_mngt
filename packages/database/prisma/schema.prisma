generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("CM_DATABASE_URL")
}



model Organization {
  id                 String             @id @default(uuid()) @db.UniqueIdentifier
  name               String
  slug               String             @unique
  legalName          String?            @map("legal_name")
  businessType       String?            @map("business_type")
  country            String?            @db.Char(2)
  timezone           String?
  defaultLanguage    String?            @map("default_language")
  defaultRegulation  String?            @map("default_regulation")
  billingEmail       String?            @map("billing_email")
  technicalContact   String?            @map("technical_contact")
  privacyContact     String?            @map("privacy_contact")
  dpoDetails         String?            @map("dpo_details")
  storeConsentIpAddress Boolean         @default(true) @map("store_consent_ip_address")
  geoTargetingDisabled  Boolean         @default(false) @map("geo_targeting_disabled")
  whiteLabel            String? @db.NVarChar(Max)           @map("white_label")
  ssoConfig             String? @db.NVarChar(Max)           @map("sso_config")
  retentionPolicy       String? @db.NVarChar(Max)           @map("retention_policy")
  dataResidencyRegion   String?         @map("data_residency_region") @db.VarChar(32)
  onboardingStep     Int                @default(0) @map("onboarding_step")
  onboardingComplete Boolean            @default(false) @map("onboarding_complete")
  status             String @default("ACTIVE")
  deletedAt          DateTime?          @map("deleted_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  users     User[]
  domains   Domain[]
  auditLogs AuditLog[]
  notifications Notification[]
  reportSchedules ReportSchedule[]
  apiKeys         ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  domainGroups    DomainGroup[]
  customRoles     OrganizationCustomRole[]

  @@index([status])
  @@map("organizations")
}

model User {
  id                String     @id @default(uuid()) @db.UniqueIdentifier
  organizationId    String?    @map("organization_id") @db.UniqueIdentifier
  auth0Sub          String?    @unique @map("auth0_sub")
  email             String     @unique
  passwordHash      String?    @map("password_hash")
  firstName         String     @map("first_name")
  lastName          String     @map("last_name")
  emailVerified     Boolean    @default(false) @map("email_verified")
  emailVerifiedAt   DateTime?  @map("email_verified_at")
  status            String @default("PENDING")
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until")
  lastLoginAt       DateTime?  @map("last_login_at")
  deletedAt         DateTime?  @map("deleted_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  organization        Organization?         @relation(fields: [organizationId], references: [id])
  roles               UserRole[]
  refreshTokens       RefreshToken[]
  loginHistory        LoginHistory[]
  auditLogs           AuditLog[]
  emailVerifications  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  customRoles         UserCustomRole[]
  domainAccess        UserDomainAccess[]

  @@index([organizationId])
  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  slug      String   @unique
  name      String
  module    String
  createdAt DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.UniqueIdentifier
  roleId    String   @map("role_id") @db.UniqueIdentifier
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.UniqueIdentifier
  permissionId String @map("permission_id") @db.UniqueIdentifier

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.UniqueIdentifier
  userId    String    @map("user_id") @db.UniqueIdentifier
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model LoginHistory {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  userId    String   @map("user_id") @db.UniqueIdentifier
  success   Boolean
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("login_history")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.UniqueIdentifier
  userId    String    @map("user_id") @db.UniqueIdentifier
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.UniqueIdentifier
  userId    String    @map("user_id") @db.UniqueIdentifier
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  userId         String?  @map("user_id") @db.UniqueIdentifier
  organizationId String?  @map("organization_id") @db.UniqueIdentifier
  action         String
  module         String
  previousValue  String? @db.NVarChar(Max)    @map("previous_value")
  newValue       String? @db.NVarChar(Max)    @map("new_value")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([module, action])
  @@map("audit_logs")
}






model Domain {
  id                 String                   @id @default(uuid()) @db.UniqueIdentifier
  organizationId     String                   @map("organization_id") @db.UniqueIdentifier
  hostname           String                   @unique
  domainKey          String                   @unique @map("domain_key")
  domainType         String               @default("ROOT") @map("domain_type")
  isProduction       Boolean                  @default(true) @map("is_production")
  enabled            Boolean                  @default(true)
  groupName          String?                  @map("group_name")
  scanLimit          Int                      @default(10) @map("scan_limit")
  scanFrequency      String            @default("MANUAL") @map("scan_frequency")
  nextScanAt         DateTime?                @map("next_scan_at")
  environment        String                   @default("production")
  region             String?
  autoBlocking       Boolean                  @default(true) @map("auto_blocking")
  debugMode          Boolean                  @default(false) @map("debug_mode")
  configVersion      Int                      @default(1) @map("config_version")
  verificationStatus String @default("PENDING") @map("verification_status")
  verificationMethod String? @map("verification_method")
  verificationToken  String                   @map("verification_token")
  verifiedAt         DateTime?                @map("verified_at")
  lastVerifiedAt     DateTime?                @map("last_verified_at")
  sdkLastSeenAt      DateTime?                @map("sdk_last_seen_at")
  sdkLastHeartbeat   String? @db.NVarChar(Max)                    @map("sdk_last_heartbeat")
  deletedAt          DateTime?                @map("deleted_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installationChecks   InstallationValidation[]
  consentCategories    ConsentCategory[]
  policyVersions       PolicyVersion[]
  consentRenewals      ConsentRenewal[]
  consentSubmissions   ConsentSubmission[]
  domainScans          DomainScan[]
  domainCookies        DomainCookie[]
  blockingViolations   BlockingViolation[]
  notifications        Notification[]
  groupMembers         DomainGroupMember[]
  userAccess           UserDomainAccess[]
  aiSuggestions        AiSuggestion[]
  regressionTestRuns   RegressionTestRun[]

  @@index([organizationId])
  @@index([verificationStatus])
  @@index([scanFrequency, nextScanAt])
  @@map("domains")
}

model InstallationValidation {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  domainId       String   @map("domain_id") @db.UniqueIdentifier
  organizationId String   @map("organization_id") @db.UniqueIdentifier
  overallStatus  String @map("overall_status")
  checks         String @db.NVarChar(Max)
  createdAt      DateTime @default(now()) @map("created_at")

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, createdAt])
  @@map("installation_validations")
}





model ConsentCategory {
  id              String                    @id @default(uuid()) @db.UniqueIdentifier
  domainId        String                    @map("domain_id") @db.UniqueIdentifier
  organizationId  String                    @map("organization_id") @db.UniqueIdentifier
  slug            String
  name            String
  description     String?
  legalBasis      String?                   @map("legal_basis")
  defaultState    String @default("DISABLED") @map("default_state")
  required        Boolean                   @default(false)
  sortOrder       Int                       @default(0) @map("sort_order")
  isSystem        Boolean                   @default(false) @map("is_system")
  enabled         Boolean                   @default(true)
  externalSignals String? @db.NVarChar(Max)                     @map("external_signals")
  scriptMappings  String? @db.NVarChar(Max)                     @map("script_mappings")
  vendorPurposes  String? @db.NVarChar(Max)                     @map("vendor_purposes")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, slug])
  @@index([domainId, sortOrder])
  @@map("consent_categories")
}

model PolicyVersion {
  id                   String              @id @default(uuid()) @db.UniqueIdentifier
  domainId             String              @map("domain_id") @db.UniqueIdentifier
  organizationId       String              @map("organization_id") @db.UniqueIdentifier
  versionNumber        Int                 @map("version_number")
  status               String @default("DRAFT")
  categoriesSnapshot   String? @db.NVarChar(Max)               @map("categories_snapshot")
  bannerContent        String? @db.NVarChar(Max)               @map("banner_content")
  legalText            String? @db.NVarChar(Max)               @map("legal_text")
  regulationConfig     String? @db.NVarChar(Max)               @map("regulation_config")
  defaultConsentStates String? @db.NVarChar(Max)               @map("default_consent_states")
  supportedLanguages   String? @db.NVarChar(Max)               @map("supported_languages")
  scheduledAt          DateTime?           @map("scheduled_at")
  publishedAt          DateTime?           @map("published_at")
  archivedAt           DateTime?           @map("archived_at")
  requiresRenewal      Boolean             @default(false) @map("requires_renewal")
  renewalReason        String? @db.NVarChar(Max)               @map("renewal_reason")
  changeSummary        String?             @map("change_summary")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  domain          Domain           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  consentRenewals ConsentRenewal[]

  @@unique([domainId, versionNumber])
  @@index([domainId, status])
  @@map("policy_versions")
}

model ConsentRenewal {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  domainId        String   @map("domain_id") @db.UniqueIdentifier
  organizationId  String   @map("organization_id") @db.UniqueIdentifier
  policyVersionId String?  @map("policy_version_id") @db.UniqueIdentifier
  reason          String
  scope           String   @default("all")
  triggeredBy     String?  @map("triggered_by") @db.UniqueIdentifier
  metadata        String? @db.NVarChar(Max)
  createdAt       DateTime @default(now()) @map("created_at")

  domain        Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)
  policyVersion PolicyVersion? @relation(fields: [policyVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([domainId, createdAt])
  @@map("consent_renewals")
}

model ConsentSubmission {
  id                 String            @id @default(uuid()) @db.UniqueIdentifier
  domainId           String            @map("domain_id") @db.UniqueIdentifier
  organizationId     String            @map("organization_id") @db.UniqueIdentifier
  visitorId          String            @map("visitor_id")
  authenticatedUserId String?           @map("authenticated_user_id") @db.UniqueIdentifier
  policyVersionId    String?           @map("policy_version_id") @db.UniqueIdentifier
  configVersion      Int               @map("config_version")
  bannerVersion      Int?              @map("banner_version")
  categories         String @db.NVarChar(Max)
  vendors            String? @db.NVarChar(Max)
  region             String?
  language           String?
  regulation         String?
  collectionMethod   String            @map("collection_method")
  eventType          String  @default("INITIAL_CONSENT") @map("event_type")
  consentStatus      String     @default("PARTIAL") @map("consent_status")
  checksum           String
  proofHash          String            @map("proof_hash")
  policySnapshotHash String?           @map("policy_snapshot_hash")
  policySnapshot     String? @db.NVarChar(Max)             @map("policy_snapshot")
  previousRecordId   String?           @map("previous_record_id") @db.UniqueIdentifier
  userAgent          String?           @map("user_agent")
  ipAddressHash      String?           @map("ip_address_hash")
  expiresAt          DateTime?         @map("expires_at")
  withdrawnAt        DateTime?         @map("withdrawn_at")
  groupVisitorId   String?           @map("group_visitor_id")
  createdAt          DateTime          @default(now()) @map("created_at")

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([domainId, visitorId, createdAt])
  @@index([domainId, createdAt])
  @@index([proofHash])
  @@index([groupVisitorId, createdAt])
  @@map("consent_submissions")
}




model DomainScan {
  id              String     @id @default(uuid()) @db.UniqueIdentifier
  domainId        String     @map("domain_id") @db.UniqueIdentifier
  organizationId  String     @map("organization_id") @db.UniqueIdentifier
  status          String @default("PENDING")
  startUrl        String     @map("start_url")
  maxPages        Int        @default(25) @map("max_pages")
  maxDepth        Int        @default(2) @map("max_depth")
  includePaths    String? @db.NVarChar(Max)      @map("include_paths")
  excludePaths    String? @db.NVarChar(Max)      @map("exclude_paths")
  timeoutMs       Int        @default(30000) @map("timeout_ms")
  jsRendering     Boolean    @default(true) @map("js_rendering")
  deviceType      String     @default("desktop") @map("device_type")
  pagesScanned    Int        @default(0) @map("pages_scanned")
  cookiesFound    Int        @default(0) @map("cookies_found")
  trackersFound   Int        @default(0) @map("trackers_found")
  errorMessage    String?    @map("error_message")
  progressMessage String?    @map("progress_message")
  startedAt       DateTime?  @map("started_at")
  completedAt     DateTime?  @map("completed_at")
  durationMs      Int?       @map("duration_ms")
  createdByUserId String?    @map("created_by_user_id") @db.UniqueIdentifier
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  domain   Domain              @relation(fields: [domainId], references: [id], onDelete: Cascade)
  pages    DomainScanPage[]
  findings DomainScanFinding[]

  @@index([domainId, createdAt])
  @@index([organizationId, createdAt])
  @@map("domain_scans")
}

model DomainScanPage {
  id           String   @id @default(uuid()) @db.UniqueIdentifier
  scanId       String   @map("scan_id") @db.UniqueIdentifier
  url          String
  canonicalUrl String?  @map("canonical_url")
  status       String   @default("ok")
  depth        Int      @default(0)
  errorMessage String?  @map("error_message")
  scannedAt    DateTime @default(now()) @map("scanned_at")

  scan     DomainScan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  findings DomainScanFinding[]

  @@index([scanId])
  @@map("domain_scan_pages")
}

model DomainScanFinding {
  id            String           @id @default(uuid()) @db.UniqueIdentifier
  scanId        String           @map("scan_id") @db.UniqueIdentifier
  pageId        String?          @map("page_id") @db.UniqueIdentifier
  findingType   String  @map("finding_type")
  consentState  String @default("BEFORE_CONSENT") @map("consent_state")
  name          String
  valueSample   String?          @map("value_sample")
  cookieDomain  String?          @map("cookie_domain")
  cookiePath    String?          @map("cookie_path")
  expiresAt     DateTime?        @map("expires_at")
  secure        Boolean?
  httpOnly      Boolean?         @map("http_only")
  sameSite      String?          @map("same_site")
  isThirdParty  Boolean?         @map("is_third_party")
  pageUrl       String?          @map("page_url")
  technology    String?
  sourceUrl     String?          @map("source_url")
  metadata      String? @db.NVarChar(Max)

  scan DomainScan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  page DomainScanPage? @relation(fields: [pageId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([scanId, findingType])
  @@map("domain_scan_findings")
}




model CookieDefinition {
  id               String          @id @default(uuid()) @db.UniqueIdentifier
  organizationId   String?         @map("organization_id") @db.UniqueIdentifier
  cookieName       String          @map("cookie_name")
  provider         String
  providerDomain   String?         @map("provider_domain")
  description      String?
  purpose          String?
  category         String
  duration         String?
  dataCollected    String?         @map("data_collected")
  isThirdParty     Boolean         @default(false) @map("is_third_party")
  privacyPolicyUrl String?         @map("privacy_policy_url")
  riskLevel        String @default("MEDIUM") @map("risk_level")
  aliases          String? @db.NVarChar(Max)
  detectionPatterns String @db.NVarChar(Max)           @map("detection_patterns")
  isSystem         Boolean         @default(true) @map("is_system")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  domainCookies DomainCookie[]

  @@index([organizationId])
  @@index([cookieName])
  @@map("cookie_definitions")
}

model DomainCookie {
  id                 String              @id @default(uuid()) @db.UniqueIdentifier
  domainId           String              @map("domain_id") @db.UniqueIdentifier
  organizationId     String              @map("organization_id") @db.UniqueIdentifier
  cookieKey          String              @map("cookie_key")
  cookieName         String              @map("cookie_name")
  cookieDomain       String?             @map("cookie_domain")
  provider           String?
  providerDomain     String?             @map("provider_domain")
  description        String?
  purpose            String?
  category           String?
  duration           String?
  dataCollected      String?             @map("data_collected")
  isThirdParty       Boolean?            @map("is_third_party")
  privacyPolicyUrl   String?             @map("privacy_policy_url")
  riskLevel          String?    @map("risk_level")
  cookieDefinitionId String?             @map("cookie_definition_id") @db.UniqueIdentifier
  matchMethod        String?  @map("match_method")
  matchConfidence    Int?                @map("match_confidence")
  reviewStatus       String  @default("PENDING") @map("review_status")
  firstSeenAt        DateTime            @map("first_seen_at")
  lastSeenAt         DateTime            @map("last_seen_at")
  lastScanId         String?             @map("last_scan_id") @db.UniqueIdentifier
  seenCount          Int                 @default(1) @map("seen_count")
  expiresAt          DateTime?           @map("expires_at")
  foundBeforeConsent Boolean             @default(false) @map("found_before_consent")
  sourceUrl          String?             @map("source_url")
  metadata           String? @db.NVarChar(Max)
  reviewedByUserId   String?             @map("reviewed_by_user_id") @db.UniqueIdentifier
  reviewedAt         DateTime?           @map("reviewed_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  domain           Domain            @relation(fields: [domainId], references: [id], onDelete: Cascade)
  cookieDefinition CookieDefinition? @relation(fields: [cookieDefinitionId], references: [id], onDelete: SetNull)

  @@unique([domainId, cookieKey])
  @@index([domainId, reviewStatus])
  @@index([organizationId])
  @@map("domain_cookies")
}

model BlockingViolation {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  domainId       String   @map("domain_id") @db.UniqueIdentifier
  organizationId String   @map("organization_id") @db.UniqueIdentifier
  url            String
  resourceType   String   @map("resource_type")
  category       String?
  vendor         String?
  rulePattern    String?  @map("rule_pattern")
  pageUrl        String?  @map("page_url")
  createdAt      DateTime @default(now()) @map("created_at")

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, createdAt])
  @@map("blocking_violations")
}


model Notification {
  id             String               @id @default(uuid()) @db.UniqueIdentifier
  organizationId String               @map("organization_id") @db.UniqueIdentifier
  domainId       String?              @map("domain_id") @db.UniqueIdentifier
  type           String
  title          String
  message        String
  severity       String @default("INFO")
  readAt         DateTime?            @map("read_at")
  metadata       String? @db.NVarChar(Max)
  createdAt      DateTime             @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain       Domain?      @relation(fields: [domainId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, createdAt])
  @@index([organizationId, readAt])
  @@map("notifications")
}



model ReportSchedule {
  id              String                  @id @default(uuid()) @db.UniqueIdentifier
  organizationId  String                  @map("organization_id") @db.UniqueIdentifier
  domainId        String?                 @map("domain_id") @db.UniqueIdentifier
  reportType      String              @map("report_type")
  frequency       String
  deliveryEmail   String?                 @map("delivery_email")
  deliveryWebhook String?                 @map("delivery_webhook")
  enabled         Boolean                 @default(true)
  lastRunAt       DateTime?               @map("last_run_at")
  nextRunAt       DateTime?               @map("next_run_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs           ReportRun[]

  @@index([organizationId])
  @@map("report_schedules")
}


model ReportRun {
  id             String          @id @default(uuid()) @db.UniqueIdentifier
  organizationId String          @map("organization_id") @db.UniqueIdentifier
  scheduleId     String?         @map("schedule_id") @db.UniqueIdentifier
  reportType     String      @map("report_type")
  status         String
  resultSummary  String? @db.NVarChar(Max)           @map("result_summary")
  deliveredTo    String?         @map("delivered_to")
  createdAt      DateTime        @default(now()) @map("created_at")

  schedule ReportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("report_runs")
}


model ApiKey {
  id              String            @id @default(uuid()) @db.UniqueIdentifier
  organizationId  String            @map("organization_id") @db.UniqueIdentifier
  name            String
  keyPrefix       String            @map("key_prefix")
  keyHash         String            @unique @map("key_hash")
  scopes          String @db.NVarChar(Max)
  environment     String @default("PRODUCTION")
  lastUsedAt      DateTime?         @map("last_used_at")
  expiresAt       DateTime?         @map("expires_at")
  revokedAt       DateTime?         @map("revoked_at")
  createdByUserId String?           @map("created_by_user_id") @db.UniqueIdentifier
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("api_keys")
}


model WebhookEndpoint {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @map("organization_id") @db.UniqueIdentifier
  url            String
  secret         String
  secretPrefix   String   @map("secret_prefix")
  events         String @db.NVarChar(Max)
  enabled        Boolean  @default(true)
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId, createdAt])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id                String                @id @default(uuid()) @db.UniqueIdentifier
  webhookEndpointId String                @map("webhook_endpoint_id") @db.UniqueIdentifier
  organizationId    String                @map("organization_id") @db.UniqueIdentifier
  eventType         String                @map("event_type")
  payload           String @db.NVarChar(Max)
  status            String @default("PENDING")
  attemptCount      Int                   @default(0) @map("attempt_count")
  lastAttemptAt     DateTime?             @map("last_attempt_at")
  nextRetryAt       DateTime?             @map("next_retry_at")
  responseStatus    Int?                  @map("response_status")
  responseBody      String?               @map("response_body")
  errorMessage      String?               @map("error_message")
  deliveredAt       DateTime?             @map("delivered_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  endpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@index([webhookEndpointId, createdAt])
  @@index([organizationId, createdAt])
  @@map("webhook_deliveries")
}

model ApiIdempotencyKey {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @map("organization_id") @db.UniqueIdentifier
  apiKeyId       String?  @map("api_key_id") @db.UniqueIdentifier
  idempotencyKey String   @map("idempotency_key")
  method         String
  path           String
  statusCode     Int      @map("status_code")
  responseBody   String @db.NVarChar(Max)     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  @@unique([organizationId, idempotencyKey])
  @@index([expiresAt])
  @@map("api_idempotency_keys")
}

model DomainGroup {
  id                String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId    String   @map("organization_id") @db.UniqueIdentifier
  name              String
  slug              String
  shareConsent      Boolean  @default(true) @map("share_consent")
  consentSyncSecret String   @map("consent_sync_secret")
  parentDomainId    String?  @map("parent_domain_id") @db.UniqueIdentifier
  allowedHostnames  String @db.NVarChar(Max)     @default("[]") @map("allowed_hostnames")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      DomainGroupMember[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("domain_groups")
}

model DomainGroupMember {
  groupId  String @map("group_id") @db.UniqueIdentifier
  domainId String @map("domain_id") @db.UniqueIdentifier
  role     String @default("member")

  group  DomainGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  domain Domain      @relation(fields: [domainId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([groupId, domainId])
  @@index([domainId])
  @@map("domain_group_members")
}

model OrganizationCustomRole {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @map("organization_id") @db.UniqueIdentifier
  slug           String
  name           String
  description    String?
  permissions    String @db.NVarChar(Max)     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  UserCustomRole[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("organization_custom_roles")
}

model UserCustomRole {
  userId      String   @map("user_id") @db.UniqueIdentifier
  customRoleId String @map("custom_role_id") @db.UniqueIdentifier
  createdAt   DateTime @default(now()) @map("created_at")

  customRole OrganizationCustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  user       User                   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, customRoleId])
  @@map("user_custom_roles")
}

model UserDomainAccess {
  userId      String   @map("user_id") @db.UniqueIdentifier
  domainId    String   @map("domain_id") @db.UniqueIdentifier
  permissions String @db.NVarChar(Max)     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, domainId])
  @@index([domainId])
  @@map("user_domain_access")
}



model AiSuggestion {
  id             String             @id @default(uuid()) @db.UniqueIdentifier
  organizationId String             @map("organization_id") @db.UniqueIdentifier
  domainId       String             @map("domain_id") @db.UniqueIdentifier
  suggestionType String   @map("suggestion_type")
  status         String @default("PENDING")
  targetType     String             @map("target_type")
  targetId       String?            @map("target_id") @db.UniqueIdentifier
  confidence     Float?
  suggestion     String @db.NVarChar(Max)
  evidence       String? @db.NVarChar(Max)
  createdBy      String?            @map("created_by")
  decidedBy      String?            @map("decided_by") @db.UniqueIdentifier
  decidedAt      DateTime?          @map("decided_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, status])
  @@index([organizationId, createdAt])
  @@map("ai_suggestions")
}

model RegressionTestRun {
  id             String                @id @default(uuid()) @db.UniqueIdentifier
  organizationId String                @map("organization_id") @db.UniqueIdentifier
  domainId       String                @map("domain_id") @db.UniqueIdentifier
  overallStatus  String @map("overall_status")
  scenarios      String @db.NVarChar(Max)
  createdAt      DateTime              @default(now()) @map("created_at")

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, createdAt])
  @@map("regression_test_runs")
}
