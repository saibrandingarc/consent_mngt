# Three production App Services (Node 22 LTS).
# Secrets: AZUREAPPSERVICE_PUBLISHPROFILE_WEB_PROD (or AZUREAPPSERVICE_PUBLISHPROFILE_PROD),
# AZUREAPPSERVICE_PUBLISHPROFILE_API_PROD, AZUREAPPSERVICE_PUBLISHPROFILE_ADMIN_PROD.

NODE_ENV=production
APP_BASE_URL=https://consentmngt.azurewebsites.net
WEB_URL=https://consentmngt.azurewebsites.net
ADMIN_URL=https://consentmngt-admin.azurewebsites.net
NEXT_PUBLIC_API_URL=https://consentmngt-api.azurewebsites.net/api/v1
API_PUBLIC_URL=https://consentmngt-api.azurewebsites.net/api/v1
CM_DATABASE_URL=sqlserver://HOST:1433;database=consent_mngt;user=USER;password={PASSWORD};encrypt=true;trustServerCertificate=true
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_AUDIENCE=
AUTH0_ISSUER_URL=
