# Paste these into Azure App Service "consentmngt" (production) → Configuration → Application settings.
# Create the App Service, then add GitHub secret AZUREAPPSERVICE_PUBLISHPROFILE_PROD
# and optional repo variables AZURE_PROD_APP_NAME / AZURE_PROD_URL.

NODE_ENV=production
APP_BASE_URL=https://consentmngt.azurewebsites.net
WEB_URL=https://consentmngt.azurewebsites.net
NEXT_PUBLIC_API_URL=https://consentmngt.azurewebsites.net/api/v1
ADMIN_URL=http://localhost:3001
CM_DATABASE_URL=sqlserver://HOST:1433;database=consent_mngt;user=USER;password={PASSWORD};encrypt=true;trustServerCertificate=true
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_AUDIENCE=
AUTH0_ISSUER_URL=
