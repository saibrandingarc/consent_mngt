# One-time setup: create secrets for Cloud Run API service.
# Run from project root after: gcloud config set project myweb-503314

# 1. Database (Neon PostgreSQL)
# echo -n "sqlserver://HOST:1433;database=DB;user=USER;password=PASSWORD;encrypt=true" | \
#   gcloud secrets create DATABASE_URL --data-file=-

# 2. JWT secrets (generate with: openssl rand -hex 32)
# echo -n "your-access-secret" | gcloud secrets create JWT_ACCESS_SECRET --data-file=-
# echo -n "your-refresh-secret" | gcloud secrets create JWT_REFRESH_SECRET --data-file=-

