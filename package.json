{
  "name": "cmp",
  "version": "0.1.0",
  "private": true,
  "author": "saibrandingarc",
  "repository": {
    "type": "git",
    "url": "https://github.com/saibrandingarc/consent_mngt.git"
  },
  "description": "Consent Management Platform monorepo",
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@cmp/api",
    "dev:admin": "turbo run dev --filter=@cmp/admin",
    "build:sdk": "pnpm --filter @cmp/sdk build",
    "test:sdk": "pnpm --filter @cmp/sdk test",
    "test:sdk:browser": "pnpm --filter @cmp/sdk test:browser",
    "dev:web": "turbo run dev --filter=@cmp/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @cmp/database generate",
    "db:migrate": "pnpm --filter @cmp/database migrate:dev",
    "db:migrate:deploy": "prisma migrate deploy --schema=packages/database/prisma/schema.prisma",
    "db:seed": "pnpm --filter @cmp/database seed",
    "db:import-postgres": "pnpm --filter @cmp/database import:postgres",
    "start": "pnpm --filter @cmp/api start",
    "db:setup": "pnpm db:migrate:deploy && pnpm db:seed",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "prettier": "^3.5.3",
    "prisma": "6.19.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
