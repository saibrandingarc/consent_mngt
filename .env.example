# Database (Microsoft SQL Server)
# Local Docker: sqlserver://localhost:1433;database=cmp;user=sa;password=Cmp_Dev_Passw0rd;encrypt=true;trustServerCertificate=true
# Azure SQL:    sqlserver://HOST:1433;database=DB;user=USER;password=PASSWORD;encrypt=true
CM_DATABASE_URL="sqlserver://localhost:1433;database=cmp;user=sa;password=Cmp_Dev_Passw0rd;encrypt=true;trustServerCertificate=true"

# API
API_PORT=4000
API_PREFIX=api/v1
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App URLs
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Web app public URL (Auth0 callbacks for marketing site)
APP_BASE_URL=http://localhost:3000

# Auth0 — CMP-dedicated application (consent_mngt), separate from varnarc
# Web callbacks:  http://localhost:3000/auth/callback
# Admin callbacks: http://localhost:3001/auth/callback
AUTH0_DOMAIN=your-tenant.us.auth0.com
CM_AUTH0_CLIENT_ID=
CM_AUTH0_CLIENT_SECRET=
# Local dev aliases (optional — CM_* takes precedence when set)
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET= # openssl rand -hex 32
AUTH0_AUDIENCE=https://api.consent-management.varnarc.com
AUTH0_ISSUER_URL=https://your-tenant.us.auth0.com/
NEXT_PUBLIC_AUTH0_CONFIGURED=true

# Email (optional — tokens logged to console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CMP <noreply@localhost>"
# Set to true when SMTP is configured in production
EMAIL_VERIFICATION_ENABLED=false

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Domain verification
# When true, domains are verified automatically when added (no DNS/meta/file on the website)
DOMAIN_AUTO_VERIFY=true
# When true, first CMP SDK heartbeat also verifies the domain
DOMAIN_AUTO_VERIFY_ON_HEARTBEAT=true

# Geo — optional IP geolocation when CDN country headers are absent (uses ipapi.co)
GEOIP_ENABLED=false
